# ============================================
# Dockerfile de Production - TM20 Server
# Optimisé pour Dokploy/Hostinger
# ============================================

# Stage 1: Builder
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Installation des dépendances système pour la compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Création du virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Installation des dépendances Python
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir gunicorn gevent

# ------------------------------------------------------------------
# Tailwind CLI autonome.
# Binaire statique : aucun Node, aucun node_modules, aucun lockfile npm
# dans un projet par ailleurs 100 % Python.
# v3 epinglee : la v4 est CSS-first et rendrait `tailwind.config.js` inerte.
# TARGETARCH est indispensable -- l'image se construit en arm64 ici, et
# l'asset s'appelle alors `tailwindcss-linux-arm64`.
# ------------------------------------------------------------------
ARG TAILWIND_VERSION=3.4.17
ARG TARGETARCH
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) TW_ARCH=x64 ;; \
      arm64) TW_ARCH=arm64 ;; \
      *) echo "architecture non supportee: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    apt-get update && apt-get install -y --no-install-recommends curl ca-certificates; \
    curl -fsSL -o /usr/local/bin/tailwindcss \
      "https://github.com/tailwindlabs/tailwindcss/releases/download/v${TAILWIND_VERSION}/tailwindcss-linux-${TW_ARCH}"; \
    chmod +x /usr/local/bin/tailwindcss; \
    /usr/local/bin/tailwindcss --help > /dev/null; \
    rm -rf /var/lib/apt/lists/*

# Compilation de la feuille de style. Le `content` de tailwind.config.js
# balaie templates/ et devices/ : ils doivent etre presents pour que le purge
# conserve les classes reellement utilisees.
WORKDIR /app
COPY tailwind.config.js ./
COPY static/ ./static/
COPY templates/ ./templates/
COPY devices/ ./devices/
RUN tailwindcss -i static/src/app.css -o static/dist/app.css --minify


# ============================================
# Stage 2: Runtime de Production
# ============================================
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    DJANGO_SETTINGS_MODULE=config.settings \
    LOG_DIR=/var/log/tm20

WORKDIR /app

# Installation des dépendances runtime uniquement
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copie du virtual environment depuis le builder
COPY --from=builder /opt/venv /opt/venv

# Copie du code source
COPY . .

# ORDRE CRITIQUE : `static/dist/app.css` est genere au build et gitignore, donc
# absent du contexte sur un clone propre. Il doit etre injecte AVANT
# `collectstatic` -- sinon le manifeste ne le contient pas, `{% static %}` leve
# « Missing staticfiles manifest entry » et TOUTES les pages renvoient 500.
COPY --from=builder /app/static/dist/app.css ./static/dist/app.css

# Collecte des fichiers statiques.
# collectstatic importe les settings : avec DEBUG=0, une DJANGO_SECRET_KEY est
# obligatoire. On fournit une clé factice valable UNIQUEMENT pour cette étape de
# build (non persistée dans l'image) ; collectstatic n'a besoin ni d'un vrai
# secret ni de la base de données.
RUN DJANGO_SECRET_KEY=build-time-collectstatic-only python manage.py collectstatic --noinput

# Création de l'utilisateur non-root
RUN useradd -m -u 1000 appuser && \
    mkdir -p /app/logs /app/media /app/staticfiles /var/log/tm20 && \
    chown -R appuser:appuser /app /var/log/tm20

# Script d'entrypoint intégré
RUN echo '#!/bin/bash\n\
set -e\n\
echo "🔄 Running migrations..."\n\
python manage.py migrate --noinput || true\n\
echo "✅ Migrations completed"\n\
echo "🚀 Starting application..."\n\
exec "$@"' > /app/docker-entrypoint.sh && \
    chmod +x /app/docker-entrypoint.sh && \
    chown appuser:appuser /app/docker-entrypoint.sh

USER appuser


ENTRYPOINT ["/app/docker-entrypoint.sh"]

# Architecture unifiee : HTTP (admin + dashboard + API) ET WebSocket (terminaux
# + dashboard temps reel) servis par un seul serveur ASGI (daphne, mono-process
# -> l'EventBus/DeviceManager en memoire suffit au temps reel, async, adapte a
# 100+ terminaux). On ecoute sur 8000, le port applicatif historique attendu par
# le reverse-proxy (Dokploy/Traefik). Les terminaux joignent le port 7788 publie
# cote compose et redirige vers ce meme serveur (ws://IP:7788/ws/tm20/).
EXPOSE 8000

# Les terminaux TM20 ne repondent pas aux frames ping WebSocket : avec les
# defauts de daphne (ping-interval 20 / ping-timeout 30) autobahn coupe la
# connexion ~50 s apres le dernier message (close 1006). --ping-timeout 0
# desactive cette coupure, le ping periodique restant utile pour NAT/proxy.
CMD ["daphne", "-b", "0.0.0.0", "-p", "8000", \
     "--ping-interval", "30", "--ping-timeout", "0", \
     "config.asgi:application"]
