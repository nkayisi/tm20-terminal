# Configuration de Production - TM20 Server

# Django (OBLIGATOIRE)
DJANGO_SECRET_KEY=changez-cette-cle-secrete-en-production
DEBUG=0
# Liste séparée par des virgules (PAS du JSON) : mon-domaine.com,localhost ou *
ALLOWED_HOSTS=votre-domaine.com,*
CSRF_TRUSTED_ORIGINS=http://148.230.123.78:3000

# Database (OBLIGATOIRE)
DATABASE_URL=postgres://tm20_user:changez_mot_de_passe@postgres:5432/tm20_db
POSTGRES_DB=tm20_db
POSTGRES_USER=tm20_user
POSTGRES_PASSWORD=changez_mot_de_passe

# Redis
REDIS_URL=redis://redis:6379/0

# Cookies sécurisés (HTTPS). Mettre 0 seulement si derrière un proxy HTTP interne.
SECURE_COOKIES=1

# ==========================================================
# Terminaux TM20
# Ces variables ne prennent effet que parce que docker-compose.prod.yml les
# transmet explicitement aux conteneurs : `.env` est exclu de l'image par
# .dockerignore, rien n'est lu depuis le disque en production.
# ==========================================================
# Fuseau horaire du site (vide => UTC). Commande trois choses a la fois :
#   - l'heure envoyee aux terminaux (`cloudtime` / `settime`) ;
#   - l'interpretation des horodatages recus, que les TM20 emettent en heure
#     murale locale sans jamais indiquer leur fuseau ;
#   - la restitution : affichage dashboard, bornes de journee, heure envoyee
#     aux services tiers.
# Postgres stocke toujours de l'UTC (USE_TZ=True) ; une valeur fausse ici ne
# corrompt donc rien en base, mais decale de son offset tout ce qui s'affiche
# et tout ce qui s'exporte.
TM20_TERMINAL_TIMEZONE=Africa/Kinshasa

# Sonde de vivacite applicative (gettime) et delai de fermeture d'une
# connexion restee silencieuse malgre les sondes.
TM20_HEARTBEAT_INTERVAL=30
TM20_CONNECTION_TIMEOUT=600

# 1 = seuls les terminaux crees et coches `is_whitelisted` peuvent s'enregistrer.
TM20_REQUIRE_WHITELIST=0
